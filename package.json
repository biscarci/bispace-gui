{
  "name": "@bispace/ui",
  "version": "0.1.0",
  "description": "Componenti React e tema Tailwind \"Tavola\" condivisi dai gestionali Bispace",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tema.css": "./src/tema.css"
  },
  "files": [
    "src",
    "!src/__test__",
    "!src/test",
    "STILE.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "tipi": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verifica": "npm run tipi && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0"
  },
  "peerDependencies": {
    "lucide-react": ">=1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biscarci/bispace-gui.git"
  }
}
